const { S3Client, GetObjectCommand } = require('@aws-sdk/client-s3');
const Sharp = require('sharp');
const querystring = require('querystring');

// 설정 값 (배포 시 자동 주입)
const s3Client = new S3Client({ region: '{{S3_REGION}}' });
const BUCKET = '{{S3_BUCKET}}';
const MAX_RESPONSE_SIZE = 750000; // ~750KB (base64로 인코딩되면 1MB에 근접)

// 지원되는 이미지 형식
const IMAGE_FORMATS = ['jpg', 'jpeg', 'png', 'webp', 'gif', 'avif', 'tiff'];

// Stream을 Buffer로 변환하는 헬퍼 함수
async function streamToBuffer(stream) {
    const chunks = [];
    for await (const chunk of stream) {
        chunks.push(chunk);
    }
    return Buffer.concat(chunks);
}

exports.handler = async (event) => {
    const request = event.Records[0].cf.request;
    const uri = request.uri;

    try {
        // 쿼리스트링에서 리사이징 파라미터 추출
        const params = querystring.parse(request.querystring);
        const width = params.w ? parseInt(params.w) : null;
        const height = params.h ? parseInt(params.h) : null;
        const quality = params.q ? parseInt(params.q) : 80;
        const format = params.f || null;

        // S3 키 추출 (맨 앞의 / 제거)
        const s3Key = uri.substring(1);

        // 파일 확장자 확인
        const fileExtension = s3Key.split('.').pop().toLowerCase();

        // 이미지 파일이 아니면 원본 요청 그대로 반환
        if (!IMAGE_FORMATS.includes(fileExtension)) {
            return request;
        }

        // 리사이징 파라미터가 없으면 원본 요청 그대로 반환
        if (!width && !height && !format) {
            return request;
        }

        // S3에서 원본 이미지 가져오기
        const command = new GetObjectCommand({
            Bucket: BUCKET,
            Key: s3Key
        });

        const s3Response = await s3Client.send(command);
        const s3Body = await streamToBuffer(s3Response.Body);

        // Sharp로 이미지 처리
        let sharpInstance = Sharp(s3Body);

        // 리사이징
        if (width || height) {
            sharpInstance = sharpInstance.resize(width, height, {
                fit: 'inside',
                withoutEnlargement: true
            });
        }

        // 포맷 변환 및 품질 설정
        const outputFormat = format || fileExtension;
        switch (outputFormat) {
            case 'jpg':
            case 'jpeg':
                sharpInstance = sharpInstance.jpeg({ quality });
                break;
            case 'png':
                sharpInstance = sharpInstance.png({
                    compressionLevel: Math.floor((100 - quality) / 10),
                    quality: quality
                });
                break;
            case 'webp':
                sharpInstance = sharpInstance.webp({ quality });
                break;
            case 'avif':
                sharpInstance = sharpInstance.avif({ quality });
                break;
            case 'gif':
                sharpInstance = sharpInstance.gif();
                break;
            case 'tiff':
                sharpInstance = sharpInstance.tiff({ quality });
                break;
        }

        const resizedImage = await sharpInstance.toBuffer();

        // 응답 크기가 제한을 초과하면 원본 요청 그대로 반환
        if (resizedImage.length > MAX_RESPONSE_SIZE) {
            console.log('Response too large, returning original request');
            return request;
        }

        // base64 인코딩 후 크기 확인
        const base64Body = resizedImage.toString('base64');

        // base64 응답이 1MB를 초과하면 원본 요청 반환
        if (base64Body.length > 1048576) {
            console.log('Base64 response too large, returning original request');
            return request;
        }

        // Content-Type 결정
        const contentType = `image/${outputFormat === 'jpg' ? 'jpeg' : outputFormat}`;

        // 리사이즈된 이미지를 응답으로 반환
        const response = {
            status: '200',
            statusDescription: 'OK',
            headers: {
                'content-type': [{
                    key: 'Content-Type',
                    value: contentType
                }],
                'cache-control': [{
                    key: 'Cache-Control',
                    value: 'public, max-age=31536000'
                }]
            },
            body: base64Body,
            bodyEncoding: 'base64'
        };

        return response;

    } catch (error) {
        console.error('Error processing image:', error);

        // 에러 발생 시 원본 요청 그대로 반환 (S3에서 직접 가져오도록)
        return request;
    }
};